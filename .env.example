# Copie para .env e preencha. O arquivo .env NUNCA vai para o git nem para o .zip.
# Modo de triagem: rules (padrão, não precisa de chave) | groq | gemini | openai | ollama
LLM_PROVIDER=rules
# Só se usar groq/gemini/openai (chave no site do provedor). Deixe vazio caso contrário.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Em demonstração real, troque por valores próprios (JWT_SECRET com no mínimo 32 caracteres).
JWT_SECRET=
IOT_KEY_SEED=
# Simulador (perfil demo): cenário e quantidade de ciclos
CENARIO=ortopedista_ausente
CICLOS=60
INTERVALO=30
